# ---------- Runtime ----------
NODE_ENV=development
PORT=5001
# Number of reverse proxies in front of the API (e.g. 1 behind an ALB / Nginx). Needed for correct client IPs + rate limiting.
TRUST_PROXY=0

# ---------- MongoDB ----------
# Paste your Atlas URI here. The database name is set separately below.
MONGODB_URI=mongodb+srv://global_gift_pass:password-123@cluster0.qusxfkl.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=global_gift_pass

# ---------- JWT (access token) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=31a89ccb726aea9be50b0140eed7537984b3844b4b66817e2b9d57c7c0dede77f39981e1fd5157deeb9fcec8dc6df79c61ddc8b1c60b69f0daca42286b7b0cbc
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=ggp-api
JWT_AUDIENCE=ggp-admin
# Customer (storefront) tokens use a different audience so they can never be used on /api/admin
JWT_CUSTOMER_AUDIENCE=ggp-customer

# ---------- Refresh token (httpOnly cookie) ----------
REFRESH_TOKEN_TTL_DAYS=1
REFRESH_TOKEN_REMEMBER_TTL_DAYS=30
REFRESH_COOKIE_NAME=ggp_admin_rt
CUSTOMER_REFRESH_COOKIE_NAME=ggp_rt
# strict | lax | none   (use "none" only if admin UI and API are on different sites; requires COOKIE_SECURE=true)
COOKIE_SAMESITE=strict
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---------- CORS / Origins (comma separated, exact match) ----------
# Include the customer website origin too, e.g. http://localhost:5173,http://localhost:3000,https://globalgiftpass.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- SynraPay (online payments) ----------
# Without MERCHANT_ID + SIGNATURE_KEY orders are still placed, but can't be paid online.
# Development API: https://dev-api.synrapay.com/v1   Hosted checkout: https://dev-checkout.synrapay.com
SYNRAPAY_BASE=https://dev-api.synrapay.com/v1
SYNRAPAY_MERCHANT_ID=
SYNRAPAY_SIGNATURE_KEY=
# Webhook URL to register with SynraPay: https://<public api host>/api/payments/synrapay/webhook
SYNRAPAY_WEBHOOK_KEY_NAME=x-synrapay-key
SYNRAPAY_WEBHOOK_KEY_VALUE=
SYNRAPAY_WEBHOOK_SECRET=
# Only while rotating the webhook secret
SYNRAPAY_WEBHOOK_SECRET_SECONDARY=
# Defaults to the sandbox Hosted Session SDK
# SYNRAPAY_HOSTED_SESSION_JS=https://sandbox.js.synrapay.com/hosted-session.js
# Customer website. Shoppers return here after paying: the success / failure return URLs are (<STOREFRONT_URL>/pay/<order>?result=success|failure).
# Must be https (SynraPay rejects http return URLs). Shoppers return to the https site they paid from when it is in CORS_ORIGINS, otherwise here.
STOREFRONT_URL=https://customer-frontend-global-gift-pass.vercel.app
# Direct API (our own card form; card data passes through this server = PCI DSS scope).
# SynraPay must enable it per account and environment. Set false to hide the method.
SYNRAPAY_DIRECT_API=true
# auto: the card is charged when the shopper pays. manual: the amount is only held (authorized);
# an admin captures or voids it from the order page. The order is not paid until it is captured.
SYNRAPAY_DIRECT_CAPTURE=auto
# Tokenization: signed-in shoppers can save a card and pay with it next time (Direct API only).
# SynraPay must enable it per account and environment. Set false to hide saved cards.
SYNRAPAY_TOKENIZATION=true
# Default payment link validity in hours (24-720)
PAYMENT_LINK_EXPIRES_HOURS=24

# ---------- Login protection ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---------- Seed (first super admin) ----------
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@globalgiftpass.com
SEED_ADMIN_PASSWORD=password123
